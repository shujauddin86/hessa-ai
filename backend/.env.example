NODE_ENV=development
PORT=4000

# JWT
JWT_SECRET=change_this_to_a_256bit_random_secret
JWT_EXPIRES_IN=30d

# Redis (BullMQ)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# SQLite
DB_PATH=./data/hessa.db

# Storage
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
TEMP_DIR=./data/temp
MAX_FILE_SIZE_MB=2000
CHUNK_SIZE_MB=10

# Auto-delete (minutes after completion)
AUTO_DELETE_MINUTES=10

# FFmpeg
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# GPU
GPU_ENABLED=false
NVIDIA_VISIBLE_DEVICES=0

# Security
CSRF_SECRET=change_this_csrf_secret
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Fraud Detection
FRAUD_MAX_FAILED_LOGINS=5
FRAUD_LOCKOUT_MS=900000

# CDN / Download links
CDN_BASE_URL=http://localhost:4000
DOWNLOAD_LINK_TTL_SECONDS=300

# Analytics
ANALYTICS_BATCH_SIZE=50
ANALYTICS_FLUSH_MS=10000

# Subscription
RAZORPAY_KEY_ID=mock_key
RAZORPAY_KEY_SECRET=mock_secret
PAY_PER_USE_PRICE_INR=99

# ── AWS Rekognition (Face Detection Primary) ──────────────────────────────────
# Leave blank to use local face-api.js fallback only
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: use an existing Rekognition face collection (faster, cheaper at scale)
AWS_REKOGNITION_COLLECTION_ID=hessa-faces

# Face detection threshold (0-100, AWS similarity score)
FACE_SIMILARITY_THRESHOLD=90

# ── LUT Color Grading ─────────────────────────────────────────────────────────
# Place .cube LUT files in assets/luts/ matching these names
# Download free LUTs: https://luts.iwltbap.com or https://fixthephoto.com/free-luts
LUT_VIVID=cinematic_vivid.cube
LUT_MUTED=cinematic_muted.cube
LUT_CINEMATIC=cinematic_teal_orange.cube
LUT_DARK=cinematic_dark.cube
LUT_WARM=cinematic_warm.cube
